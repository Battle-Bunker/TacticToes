
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========== HELPER FUNCTIONS ===========
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Centaur principals authenticate via exchangeCentaurApiKey ->
    // signInWithCustomToken. Their uid is "centaur:<centaurId>" and their
    // token carries { centaur: true, centaurId }.
    function isCentaur() {
      return isAuthenticated() && request.auth.token.get('centaur', false) == true;
    }

    // The game-start transaction writes meta/centaurMap with
    // { players: { [snakeID]: centaurId } }, covering every snake expanded
    // from teams x snakesPerTeam (ids `centaurId` and `centaurId#k`). A
    // centaur may act for a snake iff the map points that snake at its
    // centaurId claim.
    function centaurControlsPlayer(sessionId, gameId, playerID) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/games/$(gameId)/meta/centaurMap).data.players[playerID] == request.auth.token.centaurId;
    }

    // Commitment is binding: once a snake appears in the turn's
    // movedPlayerIDs, its staged move is frozen for the turn (no further
    // privateMoves creates). This makes movedPlayerIDs represent TRUE
    // commitment, so clients can reason robustly about what a committed
    // snake's move will be without waiting for turn resolution.
    function hasCommittedForTurn(sessionId, gameId, moveNumber, playerID) {
      return playerID in get(/databases/$(database)/documents/sessions/$(sessionId)/games/$(gameId)/moveStatuses/$(string(moveNumber))).data.movedPlayerIDs;
    }

    function isValidTeam(team) {
      return team.keys().hasAll(['id', 'name', 'color']) &&
        team.id is string && team.id.size() > 0 &&
        team.name is string && team.name.size() > 0 && team.name.size() < 100 &&
        team.color is string && team.color.size() > 0;
    }

    // Validate teams array - manually check each possible index since Firestore rules don't support loops
    // This validates up to 10 teams (our max) by checking each index individually
    function isValidTeams(teams) {
      return teams is list &&
        teams.size() <= 10 &&
        (teams.size() < 1 || isValidTeam(teams[0])) &&
        (teams.size() < 2 || isValidTeam(teams[1])) &&
        (teams.size() < 3 || isValidTeam(teams[2])) &&
        (teams.size() < 4 || isValidTeam(teams[3])) &&
        (teams.size() < 5 || isValidTeam(teams[4])) &&
        (teams.size() < 6 || isValidTeam(teams[5])) &&
        (teams.size() < 7 || isValidTeam(teams[6])) &&
        (teams.size() < 8 || isValidTeam(teams[7])) &&
        (teams.size() < 9 || isValidTeam(teams[8])) &&
        (teams.size() < 10 || isValidTeam(teams[9]));
    }

    function isValidSetup(setup) {
      let hasRequiredFields = setup.keys().hasAll([
          'teams', 'snakesPerTeam', 'boardWidth', 'boardHeight',
          'maxTurnTime', 'startRequested', 'started', 'timeCreated'
        ]);

      let validBaseFields = isValidTeams(setup.teams) &&
        setup.snakesPerTeam is int && setup.snakesPerTeam >= 1 && setup.snakesPerTeam <= 26 &&
        setup.boardWidth is int && setup.boardWidth >= 5 && setup.boardWidth <= 99 &&
        setup.boardHeight is int && setup.boardHeight >= 5 && setup.boardHeight <= 99 &&
        setup.maxTurnTime is number && setup.maxTurnTime > 0 &&
        setup.startRequested is bool &&
        setup.started is bool &&
        (setup.timeCreated is timestamp || setup.timeCreated == request.time);

      let validOptionalFields = (
        (!('maxTurns' in setup.keys()) || (setup.maxTurns is int && setup.maxTurns > 0 && setup.maxTurns <= 1000)) &&
        (!('firstTurnTime' in setup.keys()) || (setup.firstTurnTime is int && setup.firstTurnTime > 0))
      );

      let validTournamentFields = (
        (!('tournamentMode' in setup.keys()) || setup.tournamentMode is bool) &&
        (!('scheduledStartTime' in setup.keys()) || setup.scheduledStartTime == null || setup.scheduledStartTime is timestamp) &&
        (!('remainingRounds' in setup.keys()) || (setup.remainingRounds is int && setup.remainingRounds >= 0)) &&
        (!('interludeDuration' in setup.keys()) || (setup.interludeDuration is int && setup.interludeDuration >= 0))
      );

      return hasRequiredFields && validBaseFields && validOptionalFields && validTournamentFields;
    }

    function getSessionOwner(sessionId) {
      let sessionData = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return ('owner' in sessionData && sessionData.owner != null) ? sessionData.owner : null;
    }

    function isValidPrivateMove(move) {
      return move.keys().hasAll(['gameID', 'moveNumber', 'playerID', 'move', 'timestamp']) &&
        move.gameID is string &&
        move.moveNumber is int && move.moveNumber >= 0 &&
        move.playerID is string &&
        move.move is int && move.move >= 0 &&
        (move.timestamp is timestamp || move.timestamp == request.time); // Allow server timestamp on create
    }

    // A centaur commits exactly one of its own snakes (per centaurMap) per
    // write. Committing is optional — it lets the turn resolve early once
    // every snake has committed; uncommitted centaurs simply ride the turn
    // timer.
    function isValidMoveStatusUpdate(current, next, sessionId, gameId) {
      let addedIds = next.movedPlayerIDs.removeAll(current.movedPlayerIDs);
      return current.moveNumber == next.moveNumber &&
        current.alivePlayerIDs == next.alivePlayerIDs &&
        addedIds.size() == 1 &&
        centaurControlsPlayer(sessionId, gameId, addedIds[0]);
    }

    // Readiness ack a centaur writes when it sees a pending game invite.
    // The doc id is the centaur's own id; acks power the lobby's presence
    // indicator and never gate the game start.
    function isValidCentaurStatus(status, centaurStatusId) {
      return status.keys().hasOnly(['centaurId', 'ready', 'respondedAt']) &&
        status.keys().hasAll(['centaurId', 'ready', 'respondedAt']) &&
        status.centaurId == centaurStatusId &&
        status.ready == true &&
        (status.respondedAt is timestamp || status.respondedAt == request.time);
    }

    function isValidCentaurData(centaurData, centaurId) {
      return centaurData.keys().hasAll(['id', 'owner', 'name', 'public', 'createdAt']) &&
        centaurData.id == centaurId &&
        centaurData.owner is string &&
        centaurData.name is string && centaurData.name.size() >= 1 && centaurData.name.size() <= 50 &&
        centaurData.public is bool;
    }

    function isValidCentaurUpdate(centaurData, centaurId, currentData) {
      return isValidCentaurData(centaurData, centaurId) &&
        currentData.owner == request.auth.uid &&
        centaurData.owner == currentData.owner &&
        centaurData.createdAt == currentData.createdAt;
    }

    // =========== USERS COLLECTION ===========
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // =========== SESSIONS COLLECTION ===========
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        !('owner' in resource.data) || resource.data.owner == null || resource.data.owner == request.auth.uid
      ) && (
        !('owner' in request.resource.data) || request.resource.data.owner == null || request.resource.data.owner == resource.data.owner
      );

      // Setups Subcollection
      match /setups/{setupId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          isValidSetup(request.resource.data) &&
          request.resource.data.started == false;
        // Owner-only while owned; open to any signed-in user once the owner
        // has abdicated. `started` is server-only: the start transaction
        // flips it with the Admin SDK, which bypasses rules.
        allow update: if isAuthenticated() && (
            getSessionOwner(sessionId) == null ||
            getSessionOwner(sessionId) == request.auth.uid
          ) &&
          isValidSetup(request.resource.data) &&
          request.resource.data.started == resource.data.started &&
          request.resource.data.timeCreated == resource.data.timeCreated;

        // CentaurStatus Subcollection (readiness acks). A centaur may only
        // write its own doc; reads are open so the lobby can show presence.
        match /centaurStatus/{centaurStatusId} {
          allow read: if true;
          allow create, update: if isCentaur() &&
            request.auth.token.centaurId == centaurStatusId &&
            isValidCentaurStatus(request.resource.data, centaurStatusId);
          // Health recheck: a human (session owner, or anyone once ownerless)
          // may flip an ack back to ready == false; the centaur answers by
          // setting ready == true again.
          allow update: if isAuthenticated() && !isCentaur() &&
            (getSessionOwner(sessionId) == null ||
              getSessionOwner(sessionId) == request.auth.uid) &&
            request.resource.data.keys().hasOnly(['centaurId', 'ready', 'respondedAt']) &&
            request.resource.data.centaurId == resource.data.centaurId &&
            request.resource.data.ready == false;
        }
      }

      // Games Subcollection
      match /games/{gameId} {
        allow read: if true;

        // Meta Subcollection (centaurMap — written server-side only)
        match /meta/{metaId} {
          allow read: if true;
        }

        // MoveStatuses Subcollection
        match /moveStatuses/{moveStatusId} {
          allow read: if true;
          allow update: if isCentaur() &&
            isValidMoveStatusUpdate(resource.data, request.resource.data, sessionId, gameId);
        }

        // PrivateMoves Subcollection
        // Multiple creates per snake per turn are allowed: each write stages
        // a move, and turn resolution takes the last staged move submitted
        // before the turn's endTime — UNTIL the centaur commits the snake
        // (movedPlayerIDs), which freezes its staged move for the turn.
        // Reads are permitted only for one's OWN snakes' moves (moves stay
        // hidden from opponents): queries must therefore filter on playerID
        // so the rules engine can prove every result belongs to the caller.
        // This is what lets a centaur confirm which staged move the server
        // will actually use.
        match /privateMoves/{moveId} {
          allow read: if isCentaur() &&
            centaurControlsPlayer(sessionId, gameId, resource.data.playerID);
          allow create: if isCentaur() &&
            isValidPrivateMove(request.resource.data) &&
            centaurControlsPlayer(sessionId, gameId, request.resource.data.playerID) &&
            !hasCommittedForTurn(sessionId, gameId, request.resource.data.moveNumber, request.resource.data.playerID);
        }
      }
    }

    // =========== CENTAURS COLLECTION ===========
    match /centaurs/{centaurId} {
      // Public: signed-out visitors (e.g. /ladder) resolve centaur names.
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.owner == request.auth.uid &&
                       isValidCentaurData(request.resource.data, centaurId) &&
                       request.resource.data.createdAt == request.time;
      allow update: if isAuthenticated() &&
                       isValidCentaurUpdate(request.resource.data, centaurId, resource.data);
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;

      // Game invites written server-side at game start so centaurs can
      // discover their games with a single collection listener. Contents
      // mirror world-readable game data, so reads are open; writes are
      // server-only.
      match /games/{gameId} {
        allow read: if true;
      }
    }

    // =========== RANKINGS COLLECTION ===========
    match /rankings/{centaurId} {
      allow read: if true;
    }
  }
}
