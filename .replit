modules = ["web", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 4173

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8124
externalPort = 3001

[[ports]]
localPort = 8229
externalPort = 6000

[[ports]]
localPort = 8252
externalPort = 8080

[[ports]]
localPort = 8359
externalPort = 8081

[[ports]]
localPort = 8360
externalPort = 8099

[[ports]]
localPort = 8363
externalPort = 8008

[[ports]]
localPort = 8368
externalPort = 4200

[[ports]]
localPort = 8391
externalPort = 6800

[[ports]]
localPort = 8399
externalPort = 3002

[[ports]]
localPort = 8476
externalPort = 5000

[[ports]]
localPort = 8762
externalPort = 5173

[[ports]]
localPort = 8915
externalPort = 9000

[[ports]]
localPort = 8966
externalPort = 8000


[deployment]
build = ["sh", "-c", "cd frontend && npm run build && cp dist/index.html dist/404.html"]
deploymentTarget = "static"
publicDir = "frontend/dist"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[userenv]

[userenv.development]
# Both region vars are deliberately unset. They exist only as escape hatches for
# targeting a project whose Firestore is NOT in australia-southeast1, and the
# code defaults to australia-southeast1 in both places.
#
# Setting them here would be inherited by `npm run deploy` run from this shell,
# which silently wins over the default and would deploy functions to the wrong
# region: Firestore triggers fail outright against a Sydney database, and any
# callable that did deploy would 404 for a client pointed at Sydney.

[userenv.production]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
