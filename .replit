modules = ["web", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 4173

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8124
externalPort = 3001

[[ports]]
localPort = 8229
externalPort = 6000

[[ports]]
localPort = 8252
externalPort = 8080

[[ports]]
localPort = 8359
externalPort = 8081

[[ports]]
localPort = 8360
externalPort = 8099

[[ports]]
localPort = 8363
externalPort = 8008

[[ports]]
localPort = 8368
externalPort = 4200

[[ports]]
localPort = 8391
externalPort = 6800

[[ports]]
localPort = 8399
externalPort = 3002

[[ports]]
localPort = 8476
externalPort = 5000

[[ports]]
localPort = 8762
externalPort = 5173

[[ports]]
localPort = 8915
externalPort = 9000

[[ports]]
localPort = 8966
externalPort = 8000


[deployment]
build = ["bash", "scripts/replit-deploy.sh"]
deploymentTarget = "static"
publicDir = "frontend/dist"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[userenv]

[userenv.development]
# The Replit dev environment talks to the DEV Firebase project only, so that
# `npm run deploy` from this shell iterates against dev and can never reach
# production. Production values are set by scripts/replit-deploy.sh, which
# overrides rather than inherits these.
#
# tactic-toes-cyphid-dev has its Firestore in us-central1, so the region must
# match it -- the code defaults to australia-southeast1, which is correct for
# production but wrong here. One variable serves both the client and the
# functions deploy.
VITE_FIREBASE_PROJECT_ID = "tactic-toes-cyphid-dev"
VITE_FIREBASE_FUNCTIONS_REGION = "us-central1"

[userenv.production]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
