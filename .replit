modules = ["web", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 4173

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8124
externalPort = 3001

[[ports]]
localPort = 8229
externalPort = 6000

[[ports]]
localPort = 8252
externalPort = 8080

[[ports]]
localPort = 8359
externalPort = 8081

[[ports]]
localPort = 8360
externalPort = 8099

[[ports]]
localPort = 8363
externalPort = 8008

[[ports]]
localPort = 8368
externalPort = 4200

[[ports]]
localPort = 8391
externalPort = 6800

[[ports]]
localPort = 8399
externalPort = 3002

[[ports]]
localPort = 8476
externalPort = 5000

[[ports]]
localPort = 8762
externalPort = 5173

[[ports]]
localPort = 8915
externalPort = 9000

[[ports]]
localPort = 8966
externalPort = 8000


[deployment]
build = ["bash", "scripts/replit-deploy.sh"]
deploymentTarget = "static"
publicDir = "frontend/dist"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[userenv]

# Deliberately empty. Every Firebase value is per-deployment configuration, not
# a fact about this codebase, so it lives in Replit Secrets rather than in git:
#
#   workspace Secrets   -> the dev Firebase project, used by `npm run deploy`
#                          and the dev server
#   deployment Secrets  -> the production project, used by the publish build
#
# Keeping them out of here is also what stops a production publish inheriting
# dev values. See frontend/.env.example for the variable names.

[userenv.development]

[userenv.production]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
